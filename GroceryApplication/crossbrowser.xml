<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">
	<listeners>
		<listener class-name="reportgeneration.Listeners"></listener>

	</listeners>


	<test thread-count="5" name="ChromeTest">
		<parameter name="browsers" value="chrome"></parameter>

		<classes>

			<class name="testscript.ManageDeliveryBoyTest">
				<methods>
					<include name="verifyWhetherUserIsAbletoAddNewDeliveryBoy"></include>
				</methods>
			</class>
		</classes>
	</test> 
	
	<test thread-count="5" name="FirefoxTest">
		<parameter name="browsers" value="Firefox"></parameter>

		<classes>

			<class name="testscript.ManageDeliveryBoyTest">
				<methods>
					<include name="verifyWhetherUserIsAbletoAddNewDeliveryBoy"></include>
				</methods>
				
			</class>
		</classes>
	</test> 
	
	<test thread-count="5" name="SafariTest">
		<parameter name="browsers" value="Safari"></parameter>

		<classes>

			<class name="testscript.ManageDeliveryBoyTest">
				<methods>
					<include name="verifyWhetherUserIsAbletoAddNewDeliveryBoy"></include>
				</methods>
			</class>
		</classes>
	</test> 
	<!--
	Test -->
</suite> <!--
Suite -->
